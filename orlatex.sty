% Diagnostics stay at the package boundary, rather than leaking TeX internals.
\msg_new:nnn {orlatex}{context}
  { Declaration~'#1'~requires~the~#2~environment. }
\msg_new:nnn {orlatex}{option}
  { Unknown~option~'#1'.~Check~the~ORLaTeX~option~reference. }
\msg_new:nnn {orlatex}{style}
  { Unknown~style~'#1'.~Define~it~with~\string\orlatexstyle. }
\msg_new:nnn {orlatex}{nested-style}
  { A~named~style~cannot~contain~style=.~Use~visual~keys~directly. }
\msg_new:nnn {orlatex}{set-conflict}
  { Set~'#1'~has~conflicting~representations.~Use~only~one~of~size,~elements,~definition. }
\msg_new:nnn {orlatex}{objective}
  { A~model~must~have~exactly~one~objective.~Use~min~or~max. }
\msg_new:nnn {orlatex}{unnumbered}
  { Label~'#1'~requires~numbering=rows~or~numbering=model. }
\msg_new:nnn {orlatex}{row-label}
  { Row~label~'#1'~requires~numbering=rows.~Use~a~model~label~instead. }
\msg_new:nnn {orlatex}{overflow}
  { Row~#1~exceeds~the~available~width.~Use~explicit~\\~breaks,
    ~font-size=small,~or~a~wider~context. }
\msg_new:nnn {orlatex}{empty} { The~#1~environment~contains~no~declarations. }
\msg_new:nnn {orlatex}{nested} { ORLaTeX~environments~cannot~be~nested. }
\msg_new:nnn {orlatex}{dimension}
  { '#1'~must~be~nonnegative;~use~a~nonnegative~dimension. }
\msg_new:nnn {orlatex}{element-style}
  { Element~style~key~'#1'~does~not~apply~to~a~row.~Use~it~on~the~environment. }

% Configuration is data. Each layer is parsed before any preset is applied.
\prop_new:N \g__orlatex_defaults_prop
\prop_new:N \g__orlatex_setup_prop
\prop_new:N \g__orlatex_styles_prop
\prop_new:N \l__orlatex_config_prop
\prop_new:N \l__orlatex_layer_prop
\prop_new:N \l__orlatex_saved_layer_prop
\prop_new:N \l__orlatex_environment_prop
\prop_gset_from_keyval:Nn \g__orlatex_defaults_prop
  {layout=auto,density=compact,font-size=auto,row-gap=2pt,
   space-before=4pt,space-after=4pt,domain-gap=8pt,
   domain-position=auto,extend-left=0pt,extend-right=0pt,
   numbering=rows,subject-to={s.t.}}
\cs_new_protected:Npn \__orlatex_config_key:nn #1#2
  { \prop_put:Nnn \l__orlatex_layer_prop {#1}{#2} }
\keys_define:nn {orlatex/config}
  {
    layout .choices:nn = {auto,wide,stacked}
      {\__orlatex_config_key:nn {layout}{#1}},
    density .choices:nn = {relaxed,normal,compact,dense}
      {\__orlatex_config_key:nn {density}{#1}},
    font-size .choices:nn = {auto,normal,small,footnotesize,scriptsize}
      {\__orlatex_config_key:nn {font-size}{#1}},
    domain-position .choices:nn = {auto,right,below}
      {\__orlatex_config_key:nn {domain-position}{#1}},
    numbering .choices:nn = {rows,model,none}
      {\__orlatex_config_key:nn {numbering}{#1}},
    row-gap .code:n = \__orlatex_config_key:nn {row-gap}{#1},
    space-before .code:n = \__orlatex_config_key:nn {space-before}{#1},
    space-after .code:n = \__orlatex_config_key:nn {space-after}{#1},
    domain-gap .code:n = \__orlatex_config_key:nn {domain-gap}{#1},
    extend-left .code:n = \__orlatex_config_key:nn {extend-left}{#1},
    extend-right .code:n = \__orlatex_config_key:nn {extend-right}{#1},
    subject-to .code:n = \__orlatex_config_key:nn {subject-to}{#1},
    style .code:n = \__orlatex_config_key:nn {style}{#1},
    unknown .code:n = \msg_error:nnx {orlatex}{option}{\l_keys_key_str}
  }
\cs_new_protected:Npn \__orlatex_preset:n #1
  {
    \str_case:nn {#1}
      {
        {relaxed}{\prop_put_from_keyval:Nn \l__orlatex_config_prop
          {row-gap=7pt,space-before=12pt,space-after=12pt,domain-gap=16pt}}
        {normal}{\prop_put_from_keyval:Nn \l__orlatex_config_prop
          {row-gap=4pt,space-before=8pt,space-after=8pt,domain-gap=12pt}}
        {compact}{\prop_put_from_keyval:Nn \l__orlatex_config_prop
          {row-gap=2pt,space-before=4pt,space-after=4pt,domain-gap=8pt}}
        {dense}{\prop_put_from_keyval:Nn \l__orlatex_config_prop
          {row-gap=1pt,space-before=2pt,space-after=2pt,domain-gap=6pt}}
      }
  }
\cs_new_protected:Npn \__orlatex_apply_layer:
  {
    \prop_get:NnNT \l__orlatex_layer_prop {density}\l_tmpa_tl
      {\exp_args:NV \__orlatex_preset:n \l_tmpa_tl}
    \prop_map_inline:Nn \l__orlatex_layer_prop
      {\str_if_eq:nnF {##1}{style}
        {\prop_put:Nnn \l__orlatex_config_prop {##1}{##2}}}
  }
\cs_new_protected:Npn \__orlatex_resolve_layer:
  {
    \prop_set_eq:NN \l__orlatex_saved_layer_prop \l__orlatex_layer_prop
    \prop_get:NnNT \l__orlatex_layer_prop {style}\l_tmpa_tl
      {
        \prop_get:NVNTF \g__orlatex_styles_prop \l_tmpa_tl \l_tmpb_tl
          {
            \prop_clear:N \l__orlatex_layer_prop
            \keys_set:nV {orlatex/config}\l_tmpb_tl
            \__orlatex_apply_layer:
          }
          {\msg_error:nnV {orlatex}{style}\l_tmpa_tl}
      }
    \prop_set_eq:NN \l__orlatex_layer_prop \l__orlatex_saved_layer_prop
    \__orlatex_apply_layer:
  }
% Setup follows ordinary TeX grouping, like other document configuration.
\NewDocumentCommand \orlatexsetup {m}
  {
    \prop_set_eq:NN \l__orlatex_config_prop \g__orlatex_setup_prop
    \prop_clear:N \l__orlatex_layer_prop
    \keys_set:nn {orlatex/config}{#1}
    \__orlatex_resolve_layer:
    \prop_set_eq:NN \g__orlatex_setup_prop \l__orlatex_config_prop
  }
\NewDocumentCommand \orlatexstyle {mm}
  {
    \group_begin:
      \prop_clear:N \l__orlatex_layer_prop
      \keys_set:nn {orlatex/config}{#2}
      \prop_if_in:NnTF \l__orlatex_layer_prop {style}
        {\msg_error:nn {orlatex}{nested-style}}
        {\group_end: \prop_put:Nnn \g__orlatex_styles_prop {#1}{#2}
         \group_begin:}
    \group_end:
  }

% A record is seven unexpanded fields: kind, expression/symbol, description,
% index domain, label, resolved visual property list, variable type.
% Mathematical and index domains remain distinct. Math is never parsed.
\seq_new:N \l__orlatex_records_seq
\tl_new:N \l__orlatex_context_tl
\tl_new:N \l__orlatex_expression_tl
\tl_new:N \l__orlatex_description_tl
\tl_new:N \l__orlatex_for_tl
\tl_new:N \l__orlatex_label_tl
\tl_new:N \l__orlatex_title_tl
\tl_new:N \l__orlatex_model_label_tl
\tl_new:N \l__orlatex_size_tl
\tl_new:N \l__orlatex_elements_tl
\tl_new:N \l__orlatex_definition_tl
\tl_new:N \l__orlatex_type_tl
\tl_new:N \l__orlatex_sense_tl
\int_new:N \l__orlatex_objectives_int
\int_new:N \l__orlatex_senses_int
\int_new:N \l__orlatex_representations_int
\keys_define:nn {orlatex/environment}
  {
    title .tl_set:N = \l__orlatex_title_tl,
    label .tl_set:N = \l__orlatex_model_label_tl,
    unknown .code:n = \exp_args:Nnx \keys_set:nn {orlatex/config}
      {\l_keys_key_str={\exp_not:n {#1}}}
  }
\keys_define:nn {orlatex/element}
  {
    for .tl_set:N = \l__orlatex_for_tl,
    label .tl_set:N = \l__orlatex_label_tl,
    font-size .code:n = \keys_set:nn {orlatex/config}{font-size=#1},
    row-gap .code:n = \keys_set:nn {orlatex/config}{row-gap=#1},
    domain-gap .code:n = \keys_set:nn {orlatex/config}{domain-gap=#1},
    domain-position .code:n = \keys_set:nn {orlatex/config}{domain-position=#1},
    style .code:n = \keys_set:nn {orlatex/config}{style=#1},
    unknown .code:n = \msg_error:nnx {orlatex}{option}{\l_keys_key_str}
  }
\keys_define:nn {orlatex/set}
  {
    size .tl_set:N = \l__orlatex_size_tl,
    elements .tl_set:N = \l__orlatex_elements_tl,
    definition .tl_set:N = \l__orlatex_definition_tl,
    unknown .code:n = \exp_args:Nnx \keys_set:nn {orlatex/element}
      {\l_keys_key_str={\exp_not:n {#1}}}
  }
\keys_define:nn {orlatex/variable}
  {
    type .choices:nn = {continuous,nonnegative,integer,binary}
      {\tl_set:Nn \l__orlatex_type_tl {#1}},
    unknown .code:n = \exp_args:Nnx \keys_set:nn {orlatex/element}
      {\l_keys_key_str={\exp_not:n {#1}}}
  }
\keys_define:nn {orlatex/objective}
  {
    min .code:n = {\int_incr:N \l__orlatex_senses_int\tl_set:Nn \l__orlatex_sense_tl {min}},
    max .code:n = {\int_incr:N \l__orlatex_senses_int\tl_set:Nn \l__orlatex_sense_tl {max}},
    unknown .code:n = \exp_args:Nnx \keys_set:nn {orlatex/element}
      {\l_keys_key_str={\exp_not:n {#1}}}
  }
\cs_new_protected:Npn \__orlatex_element_begin:nn #1#2
  {
    \prop_set_eq:NN \l__orlatex_config_prop \l__orlatex_environment_prop
    \prop_clear:N \l__orlatex_layer_prop
    \tl_clear:N \l__orlatex_for_tl
    \tl_clear:N \l__orlatex_label_tl
    \tl_clear:N \l__orlatex_type_tl
    \keys_set:nn {orlatex/#1}{#2}
    \__orlatex_resolve_layer:
    % Styles applied to elements may only set properties that the row consumes.
    \prop_get:NnNT \l__orlatex_layer_prop {style}\l_tmpa_tl
      {
        \prop_get:NVNT \g__orlatex_styles_prop \l_tmpa_tl \l_tmpb_tl
          {
            \group_begin:
            \prop_clear:N \l__orlatex_layer_prop
            \keys_set:nV {orlatex/config}\l_tmpb_tl
            \prop_map_inline:Nn \l__orlatex_layer_prop
              {\str_case:nnF {##1}{{font-size}{}{row-gap}{}{domain-gap}{}{domain-position}{}}
                {\msg_error:nnn {orlatex}{element-style}{##1}}}
            \group_end:
          }
      }
  }
\cs_new_protected:Npn \__orlatex_store:n #1
  {
    \seq_put_right:Nx \l__orlatex_records_seq
      {{#1}{\exp_not:V \l__orlatex_expression_tl}
       {\exp_not:V \l__orlatex_description_tl}
       {\exp_not:V \l__orlatex_for_tl}{\exp_not:V \l__orlatex_label_tl}
       {\exp_not:V \l__orlatex_config_prop}{\exp_not:V \l__orlatex_type_tl}}
  }
\prg_new_conditional:Npnn \__orlatex_context:nn #1#2 {T}
  {
    \tl_if_eq:NnTF \l__orlatex_context_tl {#2}
      {\prg_return_true:}
      {\tl_if_eq:NnTF \l__orlatex_context_tl {notation}
        {\str_case:nnF {#2}
          {{sets}{\prg_return_true:}{parameters}{\prg_return_true:}
           {variables}{\prg_return_true:}}
          {\msg_error:nnnn {orlatex}{context}{#1}{or#2}\prg_return_false:}}
        {\msg_error:nnnn {orlatex}{context}{#1}{or#2}\prg_return_false:}}
  }
\NewDocumentCommand \orset {O{}mm}
  {
    \__orlatex_context:nnT {set}{sets}
      {
        \tl_clear:N \l__orlatex_size_tl
        \tl_clear:N \l__orlatex_elements_tl
        \tl_clear:N \l__orlatex_definition_tl
        \__orlatex_element_begin:nn {set}{#1}
        \int_zero:N \l__orlatex_representations_int
        \clist_map_inline:nn {size,elements,definition}
          {\tl_if_empty:cF {l__orlatex_##1_tl}
            {\int_incr:N \l__orlatex_representations_int}}
        \int_compare:nNnTF {\l__orlatex_representations_int}>{1}
          {\msg_error:nnn {orlatex}{set-conflict}{#2}}
          {
            \tl_set:Nn \l__orlatex_expression_tl {#2}
            \tl_if_empty:NF \l__orlatex_size_tl
              {\tl_put_right:Nx \l__orlatex_expression_tl
                {\exp_not:n {=\{1,2,\ldots,}\exp_not:V \l__orlatex_size_tl\exp_not:n {\}}}}
            \tl_if_empty:NF \l__orlatex_elements_tl
              {\tl_put_right:Nx \l__orlatex_expression_tl
                {\exp_not:n {=\{}\exp_not:V \l__orlatex_elements_tl\exp_not:n {\}}}}
            \tl_if_empty:NF \l__orlatex_definition_tl
              {\tl_put_right:Nx \l__orlatex_expression_tl
                {\exp_not:n {=\{}\exp_not:V \l__orlatex_definition_tl\exp_not:n {\}}}}
            \tl_set:Nn \l__orlatex_description_tl {#3}
            \__orlatex_store:n {set}
          }
      }
  }
\NewDocumentCommand \orparameter {O{}mm}
  {
    \__orlatex_context:nnT {parameter}{parameters}
      {\__orlatex_element_begin:nn {element}{#1}
       \tl_set:Nn \l__orlatex_expression_tl {#2}
       \tl_set:Nn \l__orlatex_description_tl {#3}
       \__orlatex_store:n {parameter}}
  }
\NewDocumentCommand \orvariable {O{}mm}
  {
    \__orlatex_context:nnT {variable}{variables}
      {
        \__orlatex_element_begin:nn {variable}{#1}
        \tl_if_empty:NT \l__orlatex_type_tl
          {\tl_set:Nn \l__orlatex_type_tl {continuous}}
        \tl_set:Nn \l__orlatex_expression_tl {#2}
        \tl_set:Nn \l__orlatex_description_tl {#3}
        \__orlatex_store:n {variable}
      }
  }
\NewDocumentCommand \orobjective {O{min}m}
  {
    \__orlatex_context:nnT {objective}{model}
      {
        \tl_clear:N \l__orlatex_sense_tl
        \int_zero:N \l__orlatex_senses_int
        \__orlatex_element_begin:nn {objective}{#1}
        \int_compare:nNnTF {\l__orlatex_senses_int}={1}
          {
            \int_incr:N \l__orlatex_objectives_int
            \tl_set:Nn \l__orlatex_expression_tl {#2}
            \tl_clear:N \l__orlatex_description_tl
            \exp_args:NV \__orlatex_store:n \l__orlatex_sense_tl
          }
          {\msg_error:nn {orlatex}{objective}}
      }
  }
\NewDocumentCommand \orconstraint {O{}m}
  {
    \__orlatex_context:nnT {constraint}{model}
      {\__orlatex_element_begin:nn {element}{#1}
       \tl_set:Nn \l__orlatex_expression_tl {#2}
       \tl_clear:N \l__orlatex_description_tl
       \__orlatex_store:n {constraint}}
  }

% Layout works from measured boxes, never textwidth or publisher names.
\box_new:N \l__orlatex_expression_box
\box_new:N \l__orlatex_domain_box
\box_new:N \l__orlatex_marker_box
\box_new:N \l__orlatex_number_box
\dim_new:N \l__orlatex_width_dim
\dim_new:N \l__orlatex_content_dim
\dim_new:N \l__orlatex_marker_dim
\dim_new:N \l__orlatex_number_dim
\dim_new:N \l__orlatex_gap_dim
\dim_new:N \l__orlatex_left_dim
\dim_new:N \l__orlatex_right_dim
\dim_new:N \l__orlatex_before_dim
\dim_new:N \l__orlatex_after_dim
\tl_new:N \l__orlatex_numbering_tl
\tl_new:N \l__orlatex_subject_tl
\tl_new:N \l__orlatex_layout_tl
\tl_new:N \l__orlatex_position_tl
\tl_new:N \l__orlatex_model_number_tl
\int_new:N \l__orlatex_row_int
\int_new:N \l__orlatex_pending_tag_int
\bool_new:N \l__orlatex_first_numbered_bool
\bool_new:N \l__orlatex_below_bool
\bool_new:N \l__orlatex_first_constraint_bool
\bool_new:N \l__orlatex_stacked_bool
\cs_new_protected:Npn \__orlatex_font:
  {
    \prop_get:NnN \l__orlatex_config_prop {font-size}\l_tmpa_tl
    \str_case:Vn \l_tmpa_tl
      {{normal}{\normalsize}{small}{\small}
       {footnotesize}{\footnotesize}{scriptsize}{\scriptsize}}
  }
\cs_new_protected:Npn \__orlatex_dimension:nN #1#2
  {
    \prop_get:NnN \l__orlatex_config_prop {#1}\l_tmpa_tl
    \dim_set:Nn #2 {\l_tmpa_tl}
    \dim_compare:nNnT {#2}<{0pt}
      {\msg_error:nnn {orlatex}{dimension}{#1}\dim_zero:N #2}
  }
\tl_new:N \l__orlatex_math_tl
\cs_new_protected:Npn \__orlatex_math_box:Nn #1#2
  {\tl_set:Nn \l__orlatex_math_tl {#2}
   % A single outer group shields manual row breaks from the input adapter.
   \tl_if_single:nT {#2}
     {\tl_if_head_is_group:nT {#2}
       {\tl_set:Nx \l__orlatex_math_tl {\tl_head:n {#2}}}}
   \hbox_set:Nn #1
     {$\displaystyle\begin{aligned}[t]\tl_use:N\l__orlatex_math_tl\end{aligned}$}}
\cs_new_protected:Npn \__orlatex_record_config:n #1
  {\tl_set:Nn \l__orlatex_config_prop {#1}\__orlatex_font:}
\cs_new_protected:Npn \__orlatex_environment_begin:nn #1#2
  {
    \tl_if_empty:NF \l__orlatex_context_tl {\msg_error:nn {orlatex}{nested}}
    \tl_set:Nn \l__orlatex_context_tl {#1}
    \seq_clear:N \l__orlatex_records_seq
    \int_zero:N \l__orlatex_objectives_int
    \tl_clear:N \l__orlatex_title_tl
    \tl_clear:N \l__orlatex_model_label_tl
    \prop_set_eq:NN \l__orlatex_config_prop \g__orlatex_defaults_prop
    \prop_set_eq:NN \l__orlatex_layer_prop \g__orlatex_setup_prop
    \__orlatex_apply_layer:
    \prop_clear:N \l__orlatex_layer_prop
    \keys_set:nn {orlatex/environment}{#2}
    \__orlatex_resolve_layer:
    \prop_set_eq:NN \l__orlatex_environment_prop \l__orlatex_config_prop
  }
\cs_new_protected:Npn \__orlatex_render_begin:
  {
    \prop_set_eq:NN \l__orlatex_config_prop \l__orlatex_environment_prop
    \__orlatex_font:
    \__orlatex_dimension:nN {extend-left}\l__orlatex_left_dim
    \__orlatex_dimension:nN {extend-right}\l__orlatex_right_dim
    \__orlatex_dimension:nN {space-before}\l__orlatex_before_dim
    \__orlatex_dimension:nN {space-after}\l__orlatex_after_dim
    \dim_set:Nn \l__orlatex_width_dim
      {\linewidth+\l__orlatex_left_dim+\l__orlatex_right_dim}
    \prop_get:NnN \l__orlatex_config_prop {layout}\l__orlatex_layout_tl
    \par\addvspace{\l__orlatex_before_dim}
    \int_zero:N \l__orlatex_row_int
  }
% Box a title with the first row: penalties alone cannot keep a tall objective
% beside its title at a page boundary. Remaining rows may paginate normally.
\cs_new_protected:Npn \__orlatex_title_begin:
  {
    \int_compare:nNnT {\l__orlatex_row_int}={1}
      {\tl_if_empty:NF \l__orlatex_title_tl
        {\vbox\bgroup
         \noindent\textbf{\l__orlatex_title_tl}\par\smallskip}}
  }
\cs_new_protected:Npn \__orlatex_title_end:
  {
    \int_compare:nNnT {\l__orlatex_row_int}={1}
      {\tl_if_empty:NF \l__orlatex_title_tl {\egroup}}
  }
\cs_new_protected:Npn \__orlatex_render_end:
  {\par\addvspace{\l__orlatex_after_dim}}
\cs_new_protected:Npn \__orlatex_label:n #1
  {\tl_if_blank:nF {#1}{\label{#1}}}
\cs_new_protected:Npn \__orlatex_model_numbering:
  {
    \prop_get:NnN \l__orlatex_config_prop {numbering}\l__orlatex_numbering_tl
    \prop_get:NnN \l__orlatex_config_prop {subject-to}\l__orlatex_subject_tl
    \dim_zero:N \l__orlatex_number_dim
    \tl_clear:N \l__orlatex_model_number_tl
    \str_if_eq:VnF \l__orlatex_numbering_tl {none}
      {
        \hbox_set:Nn \l__orlatex_number_box {(\theequation)}
        \dim_set:Nn \l__orlatex_number_dim {\box_wd:N \l__orlatex_number_box+12pt}
        \str_if_eq:VnT \l__orlatex_numbering_tl {model}
          {\refstepcounter{equation}
           \tl_set:Nx \l__orlatex_model_number_tl {\theequation}
           \exp_args:NV \__orlatex_label:n \l__orlatex_model_label_tl}
      }
    \str_if_eq:VnT \l__orlatex_numbering_tl {none}
      {\tl_if_empty:NF \l__orlatex_model_label_tl
        {\msg_error:nnV {orlatex}{unnumbered}\l__orlatex_model_label_tl}}
  }
\cs_new_protected:Npn \__orlatex_measure_columns:nnnnnnn #1#2#3#4#5#6#7
  {
    \int_incr:N \l__orlatex_row_int
    \int_incr:N \l__orlatex_pending_tag_int
    \group_begin:
      \__orlatex_record_config:n {#6}
      \prop_if_in:NnT \l__orlatex_config_prop {suppress-tag}
